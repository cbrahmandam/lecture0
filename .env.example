# ===== REQUIRED =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== DATABASE (auto-configured in Docker) =====
DATABASE_URL=postgresql://customs_user:customs_pass@localhost:5432/customs_db

# ===== EMAIL (for approval notifications) =====
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
APPROVAL_NOTIFY_EMAIL=approver@yourcompany.com

# ===== APP =====
FRONTEND_URL=http://localhost:3000
USD_INR_RATE=83.5

# ===== IMPORTER DEFAULTS (per your IEC) =====
DEFAULT_IEC=AAAAAAAAA      # Your 10-digit IEC code
DEFAULT_GSTIN=              # Your GSTIN
DEFAULT_PAN=                # Your PAN
